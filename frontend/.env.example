# ============================================================
# DPDPA Shield — Frontend environment variables (TEMPLATE ONLY)
# Copy to ".env" or ".env.local" — never commit files with real secrets
#
#   Windows:  copy .env.example .env.local
#   macOS:    cp .env.example .env.local
# ============================================================

# Backend API base URL (include /api prefix)
VITE_API_BASE_URL=http://localhost:8000/api

# (Optional) Canonical public URL for the portal / cmp.js hosting.
# Defaults to window.location.origin when unset (e.g. https://dpdpashield-500607.web.app).
# VITE_PUBLIC_URL=https://dpdpashield-500607.web.app

# (Optional) Override cmp.js or public API URLs in install snippets.
# VITE_CMP_SCRIPT_URL=https://dpdpashield-500607.web.app/cmp.js
# VITE_PUBLIC_API_URL=https://your-backend.run.app/public/v1
