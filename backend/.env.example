# ============================================================
# Vajra — Backend environment variables (TEMPLATE ONLY)
# Copy to ".env" and set YOUR local values — never commit ".env"
#
#   Windows:  copy .env.example .env
#   macOS:    cp .env.example .env
# ============================================================

# --- App ---
PROJECT_NAME="Vajra API"
ENVIRONMENT=development
API_V1_PREFIX=/api

# --- Database ---------------------------------------------------------------
# Replace USER and PASSWORD with your local PostgreSQL credentials.
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/dpdpa_shield

# Optional SQLite (dev only — not for production):
# DATABASE_URL=sqlite:///./dpdpa_shield.db

# --- Security ---------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# Encrypts stored data-source passwords. Leave blank to derive from SECRET_KEY.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_SOURCE_ENCRYPTION_KEY=

# --- Redis (consent decision cache) -----------------------------------------
# Local dev: docker compose -f docker-compose.db.yml up -d redis
REDIS_URL=redis://localhost:6379/0
DECISION_CACHE_TTL_SECONDS=30
DECISION_TOKEN_TTL_SECONDS=900

# --- Superadmin seed --------------------------------------------------------
# Used by: python -m app.scripts.create_superadmin
SUPERADMIN_EMAIL=superadmin@vajra.dev
SUPERADMIN_PASSWORD=CHANGE_ME_MIN_8_CHARS

# --- CORS (comma-separated frontend origins) --------------------------------
# Include both localhost and 127.0.0.1 — browsers treat them as different origins
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- SMTP (user invite emails) ----------------------------------------------
# Gmail: use an App Password, NOT your normal Gmail password.
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Create App Password: https://myaccount.google.com/apppasswords
#   3. SMTP_USER = the Gmail address that sends mail
#   4. SMTP_PASSWORD = 16-character app password (no spaces)
# Test from backend/:  python -m app.scripts.test_smtp --to recipient@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=
SMTP_FROM_NAME=Vajra

# Sign-in link included in invite emails
FRONTEND_URL=http://localhost:5173

# Public backend URL (used in CMP install snippets for data-api-url)
BACKEND_PUBLIC_URL=http://localhost:8000

# Optional overrides for CMP install snippets (defaults derive from FRONTEND_URL + BACKEND_PUBLIC_URL)
# CMP_SCRIPT_URL=https://dpdpashield-500607.web.app/cmp.js
# CMP_PUBLIC_API_URL=https://dpdpa-backend-290927690790.asia-south1.run.app/public/v1

# --- AI providers ---------------------------------------------------------
# Healthcare uses the Gemma gateway. Legacy AI/RAG uses SHIELD_AI_PROVIDER.
AI_PROVIDER=gemma

# Vertex AI — uses Application Default Credentials (no API key).
# Local uvicorn:  gcloud auth application-default login
# Local Docker:   compose mounts %APPDATA%\gcloud\application_default_credentials.json
# Cloud Run:      runtime service account (grant roles/aiplatform.user)
# Optional: VAJRA_AI_DOCS_DIR=/app/platform_docs  (set automatically by docker compose)
GOOGLE_CLOUD_PROJECT=dpdpashield-500607
GOOGLE_CLOUD_LOCATION=asia-south1
VERTEX_MODEL_ID=gemini-2.5-flash
# Leave blank to reuse VERTEX_MODEL_ID (Gemini 2.5 Flash is multimodal)
VERTEX_VISION_MODEL_ID=
VERTEX_EMBED_MODEL_ID=gemini-embedding-001
VERTEX_EMBED_DIMENSIONS=1024
VERTEX_MAX_TOKENS=4096
VERTEX_TEMPERATURE=0.3
VERTEX_VISION_MAX_TOKENS=500
# 0 = disable Gemini 2.5 thinking (faster, more reliable JSON)
VERTEX_THINKING_BUDGET=0

# Bedrock — set SHIELD_AI_PROVIDER=bedrock to use it for legacy Shield AI/RAG.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional for temporary STS credentials
# AWS_SESSION_TOKEN=
# Chat copilot — any Converse-capable model enabled in your Bedrock account, e.g.
#   anthropic.claude-3-5-sonnet-20241022-v2:0
#   us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MODEL_ID=
# Screenshot assistant — Nova Lite by default; leave blank to reuse BEDROCK_MODEL_ID.
# Or set a regional inference profile if needed, e.g. us.amazon.nova-lite-v1:0
BEDROCK_VISION_MODEL_ID=amazon.nova-lite-v1:0

# --- Data Source file uploads -----------------------------------------------
# Where uploaded data-source files are stored, and the max accepted size.
UPLOAD_DIR=uploads/data_sources
MAX_UPLOAD_BYTES=52428800   # 50 MB

# Google Drive sources use per-source credentials entered in the UI (OAuth
# Client ID + Secret + Refresh Token), so no server-wide Google config is needed.

# --- Optional (future modules) ------------------------------------------------
# REDIS_URL=redis://localhost:6379/0
# OPENAI_API_KEY=
# Healthcare Gemma gateway (empty key enables explicit offline fallbacks).
GEMINI_API_KEY=
GEMMA_MODEL_ID=gemma-4-31b-it
# Existing Shield AI/RAG supports vertex or bedrock independently.
SHIELD_AI_PROVIDER=vertex
